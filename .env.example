# LLM configuration now lives in the in-app Settings panel (gear icon, top of
# the center toolbar). Provider, API Key, Base URL, and Model are persisted via
# the app — the API key is encrypted at rest with Electron safeStorage.
#
# The variables below are only a DEV FALLBACK used when no API key has been
# saved in Settings yet (e.g. headless runs). Default provider is "mock", which
# needs no key and exercises the full plan/patch/approve flow.

# "mock" (no API key) or "deepseek"
LLM_PROVIDER=mock

# DeepSeek (OpenAI-compatible). Used only as a fallback when LLM_PROVIDER=deepseek
# and no key is configured in the Settings panel.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
