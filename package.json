{
  "name": "nlc-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "NL_Codey — local Windows GUI coding agent",
  "scripts": {
    "dev": "pnpm --filter @nlc/desktop dev",
    "build": "pnpm -r --filter \"./packages/*/*\" build && pnpm --filter @nlc/desktop build && pnpm --filter nlc build",
    "build:packages": "pnpm -r --filter \"./packages/*/*\" build",
    "docs:tui-actions": "node scripts/generate-tui-action-inventory.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:unit && pnpm test:desktop-main && pnpm test:renderer && pnpm test:preload && pnpm test:cli && pnpm test:tui:unit && pnpm test:tui:render && pnpm test:tui:pty && pnpm test:tui:e2e && pnpm test:recovery",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:desktop-main": "vitest run --config vitest.desktop-main.config.ts",
    "test:renderer": "vitest run --config vitest.renderer.config.ts",
    "test:preload": "vitest run --config vitest.preload.config.ts",
    "test:cli": "vitest run --config vitest.cli.config.ts",
    "test:tui:unit": "vitest run --config vitest.tui.config.ts",
    "test:tui:render": "vitest run --config vitest.tui-render.config.ts",
    "test:tui:pty": "vitest run --config vitest.tui-pty.config.ts",
    "test:tui:e2e": "pnpm --filter nlc build && node scripts/test-storage-abi-matrix.mjs --node-vitest vitest.tui-e2e.config.ts",
    "test:recovery": "node scripts/test-storage-abi-matrix.mjs --node",
    "test:storage:node": "node scripts/test-storage-abi-matrix.mjs --node",
    "test:storage:electron": "node scripts/test-storage-abi-matrix.mjs --electron-only",
    "test:storage:abi": "pnpm test:storage:node",
    "test:sandbox:abort:soak": "node scripts/test-sandbox-abort-soak.mjs",
    "test:integration": "pnpm test:storage:abi && vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test && pnpm test:integration",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "rebuild:native": "pnpm --filter @nlc/desktop exec electron-rebuild -f -w better-sqlite3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron-builder": "^26.8.1",
    "node-gyp": "11.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
