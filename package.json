{
  "name": "nlc-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "NL_Codey — local Windows GUI coding agent",
  "scripts": {
    "dev": "pnpm --filter @nlc/desktop dev",
    "build": "pnpm -r --filter \"./packages/*/*\" build && pnpm --filter @nlc/desktop build",
    "build:packages": "pnpm -r --filter \"./packages/*/*\" build",
    "docs:tui-actions": "node scripts/generate-tui-action-inventory.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:native": "pnpm --filter @nlc/desktop exec electron-rebuild -f -w better-sqlite3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
