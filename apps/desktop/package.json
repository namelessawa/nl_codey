{
  "name": "@nlc/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "nameless",
  "description": "NL_Codey — local Windows GUI coding agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/namelessawa/nl_codey.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "package": "electron-builder --win",
    "package:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "@nlc/agent-core": "workspace:*",
    "@nlc/distributed": "workspace:*",
    "@nlc/finetune": "workspace:*",
    "@nlc/git-integration": "workspace:*",
    "@nlc/global-memory": "workspace:*",
    "@nlc/learning": "workspace:*",
    "@nlc/llm": "workspace:*",
    "@nlc/memory": "workspace:*",
    "@nlc/orchestrator": "workspace:*",
    "@nlc/planner": "workspace:*",
    "@nlc/plugin-sdk": "workspace:*",
    "@nlc/proactive": "workspace:*",
    "@nlc/project-indexer": "workspace:*",
    "@nlc/sandbox": "workspace:*",
    "@nlc/semantic-index": "workspace:*",
    "@nlc/shared": "workspace:*",
    "@nlc/storage": "workspace:*",
    "@nlc/style-profile": "workspace:*",
    "@nlc/tools": "workspace:*",
    "@nlc/web-tools": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "diff": "^7.0.0",
    "@vscode/ripgrep": "^1.15.9",
    "bindings": "^1.5.0",
    "file-uri-to-path": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "@vscode/ripgrep-win32-x64": "1.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.nl-codey.desktop",
    "productName": "NL_Codey",
    "copyright": "Copyright (c) 2026 nameless",
    "electronVersion": "33.2.1",
    "npmRebuild": false,
    "publish": null,
    "directories": {
      "output": "../../release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,*.test.*,*.spec.*}",
      "!**/node_modules/*/{.bin,.cache}"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/bindings/**",
      "**/node_modules/file-uri-to-path/**",
      "**/node_modules/@vscode/ripgrep/**",
      "**/node_modules/@vscode/ripgrep-win32-*/**",
      "**/node_modules/@vscode/ripgrep-darwin-*/**",
      "**/node_modules/@vscode/ripgrep-linux-*/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NL_Codey",
      "deleteAppDataOnUninstall": false
    }
  }
}
