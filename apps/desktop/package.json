{
  "name": "@coding-agent/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "coding-agent",
  "description": "Local Windows GUI Coding Agent",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "package": "electron-builder --win",
    "package:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "@coding-agent/agent-core": "workspace:*",
    "@coding-agent/distributed": "workspace:*",
    "@coding-agent/finetune": "workspace:*",
    "@coding-agent/git-integration": "workspace:*",
    "@coding-agent/global-memory": "workspace:*",
    "@coding-agent/learning": "workspace:*",
    "@coding-agent/llm": "workspace:*",
    "@coding-agent/memory": "workspace:*",
    "@coding-agent/orchestrator": "workspace:*",
    "@coding-agent/planner": "workspace:*",
    "@coding-agent/plugin-sdk": "workspace:*",
    "@coding-agent/proactive": "workspace:*",
    "@coding-agent/project-indexer": "workspace:*",
    "@coding-agent/sandbox": "workspace:*",
    "@coding-agent/semantic-index": "workspace:*",
    "@coding-agent/shared": "workspace:*",
    "@coding-agent/storage": "workspace:*",
    "@coding-agent/style-profile": "workspace:*",
    "@coding-agent/tools": "workspace:*",
    "@coding-agent/web-tools": "workspace:*",
    "better-sqlite3": "^11.7.0",
    "diff": "^7.0.0",
    "@vscode/ripgrep": "^1.15.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.codingagent.desktop",
    "productName": "Coding Agent",
    "copyright": "Copyright (c) 2026 coding-agent",
    "directories": {
      "output": "../../release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,*.test.*,*.spec.*}",
      "!**/node_modules/*/{.bin,.cache}"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/bindings/**",
      "**/node_modules/file-uri-to-path/**",
      "**/node_modules/@vscode/ripgrep/**",
      "**/node_modules/@vscode/ripgrep-win32-*/**",
      "**/node_modules/@vscode/ripgrep-darwin-*/**",
      "**/node_modules/@vscode/ripgrep-linux-*/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Coding Agent",
      "deleteAppDataOnUninstall": false
    }
  }
}
