{
  "name": "nlc",
  "version": "0.1.0",
  "private": false,
  "description": "NL_Codey CLI — open the terminal UI from anywhere, or launch the desktop GUI",
  "type": "module",
  "bin": {
    "nlc": "./bin/nlc.mjs"
  },
  "main": "./src/index.ts",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nlc/agent-core": "workspace:*",
    "@nlc/llm": "workspace:*",
    "@nlc/project-indexer": "workspace:*",
    "@nlc/sandbox": "workspace:*",
    "@nlc/session": "workspace:*",
    "@nlc/shared": "workspace:*",
    "@nlc/storage": "workspace:*",
    "@nlc/tools": "workspace:*",
    "better-sqlite3": "^11.7.0",
    "@vscode/ripgrep": "^1.15.9",
    "bindings": "^1.5.0",
    "file-uri-to-path": "^1.0.0",
    "ink": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
